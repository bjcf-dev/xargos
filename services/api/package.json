{
  "name": "@xargos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "spike:live": "tsx src/spike/live.ts",
    "orca:balances": "tsx --env-file-if-exists=../../.env src/scripts/orca/balances.ts",
    "orca:create-demo-mint": "tsx --env-file-if-exists=../../.env src/scripts/orca/create-demo-mint.ts",
    "orca:create-pool": "tsx --env-file-if-exists=../../.env src/scripts/orca/create-pool.ts",
    "orca:open-position": "tsx --env-file-if-exists=../../.env src/scripts/orca/open-position.ts",
    "orca:swap": "tsx --env-file-if-exists=../../.env src/scripts/orca/swap.ts",
    "orca:build-recipe": "tsx --env-file-if-exists=../../.env src/scripts/orca/build-recipe.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@orca-so/whirlpools": "8.0.1",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^6.10.0",
    "@x402/core": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "@xargos/guard-client": "workspace:*",
    "@xargos/shared": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
