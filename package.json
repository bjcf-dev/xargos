{
  "name": "xargos",
  "private": true,
  "description": "Multi-step DeFi recipes for AI agents, paid per request with x402 on Solana, guarded on-chain: kept as promised or not executed at all.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "lefthook": "^2.2.2",
    "typescript": "^5.9.3"
  }
}
