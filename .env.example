# Copiar a .env y rellenar. Nunca commitear .env.
# Sin comentarios al final de una línea (algunos gestores los meten dentro del valor).

# ---- services/api ----
# Solo devnet
SOLANA_CLUSTER=devnet
# URL de RPC de devnet con api key (no imprimir en logs)
RPC_URL=
# Ruta al keypair del payer (fuera del repo, p. ej. ~/.config/xargos/payer-staging.json)
PAYER_KEYPAIR_PATH=
# Pubkey que recibe los pagos x402
PAY_TO_ADDRESS=
# Mint de USDC de devnet de Circle
USDC_MINT=
# Program ID del guard en devnet
GUARD_PROGRAM_ID=
# Pool de Orca propio en devnet
WHIRLPOOL_ADDRESS=
# Facilitador x402 (se decide en el spike)
X402_FACILITATOR_URL=
# Precio de la receta en unidades base de USDC (10000 = 0.01 USDC)
RECIPE_PRICE_BASE_UNITS=10000
# Código de acceso para /demo/setup
DEMO_ACCESS_CODE=
PORT=8787

# ---- apps/web (las privadas van en el panel de Netlify) ----
# mock | local | staging
NEXT_PUBLIC_API_MODE=mock
# Solo lo lee el proxy del servidor de Next
BACKEND_URL=http://localhost:8787
