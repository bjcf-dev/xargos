# Copiar a .env y rellenar. Nunca commitear .env.
# Sin comentarios al final de una línea (algunos gestores los meten dentro del valor).

# ---- services/api ----
# Solo devnet
SOLANA_CLUSTER=devnet
# URL de RPC de devnet con api key (no imprimir en logs)
RPC_URL=
# Ruta al keypair del payer (fuera del repo, p. ej. ~/.config/xargos/payer-staging.json)
PAYER_KEYPAIR_PATH=
# Alternativa para Railway, que no tiene archivos: el keypair como array JSON de 64 bytes.
# Solo en el panel de variables del host, nunca en este archivo. Si está, gana sobre la ruta
PAYER_KEYPAIR=
# Pubkey que recibe los pagos x402
PAY_TO_ADDRESS=3NxLt5rLgsT46ngFjUj2VQhsfhu1miEmARUTS8gN1MYw
# Mint de USDC de devnet de Circle
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Program ID del guard en devnet
GUARD_PROGRAM_ID=97YMLtF9e6tW3e2ynHASe4qCB2e8uGnyGh5AmJNkJmCm
# Pool de Orca propio en devnet
WHIRLPOOL_ADDRESS=3qTZVVZbPmCGE3h3GpGxNw6B3F6Z2NdYJeWiv4Kw38pS
# Mint de "USDC demo" propio (plan B de la D11; ver docs/adr/0003)
DEMO_USDC_MINT=D1PzuAbRJB1io3awJX2GDoiL1ihwK9Kt9yfciLrgJFss
# Mint del NFT de la posición de prueba (solo scripts de devnet)
TEST_POSITION=57eVnr4H1DsDdxYTTroLFe1j24XMXwQREANiUybL2Fsf
# Facilitador x402 (se decide en el spike)
X402_FACILITATOR_URL=
# Precio de la receta en unidades base de USDC (10000 = 0.01 USDC)
RECIPE_PRICE_BASE_UNITS=10000
# URL pública con la que el agente llama a la API (proxy de Netlify), sin barra final. Vacío en local
PUBLIC_RESOURCE_URL=
# Código de acceso para /demo/setup
DEMO_ACCESS_CODE=
PORT=8787

# ---- apps/web (las privadas van en el panel de Netlify) ----
# mock | local | staging
NEXT_PUBLIC_API_MODE=mock
# Solo lo lee el proxy del servidor de Next
BACKEND_URL=http://localhost:8787
